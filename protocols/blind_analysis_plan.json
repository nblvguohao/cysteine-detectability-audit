{
  "version": "1.0",
  "status": "template_not_yet_registered",
  "tasks": {
    "site_localization": {
      "unit": "protein",
      "primary_endpoints": ["top1_observed_coverage", "top2_observed_coverage"],
      "secondary_endpoints": ["mean_reciprocal_rank_if_all_candidate_cys_assayed", "not_testable_fraction", "seed_uncertainty_error_association"],
      "negative_class_metrics_allowed": false,
      "minimum_evaluable_proteins": 30,
      "target_locked_proteins": 50
    },
    "protein_occurrence": {
      "separate_model_required": true,
      "site_max_score_as_validated_classifier": false,
      "pu_or_censoring_required_if_negatives_not_defensible": true
    }
  },
  "analysis_sets": ["locked_intent_to_test", "pre_unblinding_assay_evaluable"],
  "tie_rule": "Top-1 coverage is the observed fraction among exactly tied maximum-score sites; Top-2 uses score descending then position ascending",
  "missing_outcome_rule": "not_testable and ambiguous_localization are reported, never silently converted to negative",
  "model_selection_after_unblinding": false,
  "exploratory_changes_must_be_versioned": true,
  "required_hashes": ["input_manifest", "sequences", "model", "predictions", "outcomes", "analysis_script", "final_outputs"]
}
